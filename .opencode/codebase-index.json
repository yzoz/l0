{
  "embeddingProvider": "custom",
  "customProvider": {
    "baseUrl": "http://127.0.0.1:8080/v1",
    "model": "embeddinggemma2",
    "dimensions": 768,
    "apiKey": "no-key",
    "maxTokens": 4096,
