#!/bin/zsh
set -e

cd "$(dirname "$0")"

SESSION=l0

if tmux has-session -t "$SESSION" 2>/dev/null; then
  tmux attach-session -t "$SESSION"
  exit 0
fi

make up
sleep 3

pane() {
  if [ -z "$PANE_STARTED" ]; then
    tmux new-session -d -s "$SESSION" -c "$PWD" -n l0 "$1; exec zsh"
    PANE_STARTED=1
  else
    tmux split-window -t "$SESSION" -c "$PWD" "$1; exec zsh"
  fi
  tmux select-layout -t "$SESSION" tiled
}

pane "make logs"
sleep 1
pane "poetry run fastapi run api.py --host 127.0.0.1 --port 8000 --reload"
sleep 1
pane "poetry run python run.py cons --watch"
sleep 1
pane "poetry run python run.py conf --watch"
sleep 1
pane "poetry run python run.py write --watch"
sleep 1
pane "make tx"

tmux attach-session -t "$SESSION"